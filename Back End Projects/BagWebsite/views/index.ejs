<%- include('./partials/header') %>


    <div class="w-full h-screen flex flex-col items-center justify-center bg-gradient-to-r from-blue-100 to-white px-8 pt-20">
    <div class="mb-6 flex gap-4">
        <button id="show-signup" class="px-4 py-2 rounded-full bg-blue-500 text-white font-semibold transition">Signup</button>
        <button id="show-login" class="px-4 py-2 rounded-full bg-gray-300 text-blue-700 font-semibold transition">Login</button>
    </div>
    <div class="relative w-[32rem] h-[28rem] overflow-hidden rounded-xl shadow-lg bg-white">
        <div id="panel-wrapper" class="absolute w-full h-full transition-transform duration-500" style="transform: translateX(0);">
            <!-- Signup Form -->
            <div class="absolute w-full h-full px-10 py-12 transition-all duration-500" id="signup-panel">
                <h3 class="text-3xl font-bold text-blue-600 mb-4">Create Account</h3>
                <form autocomplete="off" action="/users/register" method="post">
                    <!-- input fields... -->
                    <input class="w-full px-4 py-2 border-2 rounded mb-3" type="text" name="fullname" placeholder="Full Name">
                    <input class="w-full px-4 py-2 border-2 rounded mb-3" type="email" name="email" placeholder="Email">
                    <input class="w-full px-4 py-2 border-2 rounded mb-3" type="password" name="password" placeholder="Password">
                    <input class="w-full px-4 py-3 rounded bg-blue-500 text-white font-semibold cursor-pointer hover:bg-blue-400 transition" type="submit" value="Create My Account">
                </form>
            </div>
            <!-- Login Form -->
            <div class="absolute w-full h-full px-10 py-12 transition-all duration-500" id="login-panel" style="left:100%;">
                <h3 class="text-3xl font-bold text-blue-600 mb-4">Login</h3>
                <form autocomplete="off" action="/users/login" method="post">
                    <!-- input fields... -->
                    <input class="w-full px-4 py-2 border-2 rounded mb-3" type="email" name="email" placeholder="Email">
                    <input class="w-full px-4 py-2 border-2 rounded mb-3" type="password" name="password" placeholder="Password">
                    <input class="w-full px-4 py-3 rounded bg-blue-500 text-white font-semibold cursor-pointer hover:bg-blue-400 transition" type="submit" value="Login">
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    // Basic slide effect for panel switching
    document.getElementById('show-signup').onclick = function() {
      document.getElementById('panel-wrapper').style.transform = 'translateX(0)';
    };
    document.getElementById('show-login').onclick = function() {
      document.getElementById('panel-wrapper').style.transform = 'translateX(-100%)';
    };
</script>


    <%- include('./partials/footer') %>