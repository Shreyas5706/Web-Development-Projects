<%- include('./partials/header') %>


    <div class="pt-20 px-8 min-h-screen bg-gray-50 flex flex-col">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            <!-- Cart Items Column -->
            <div class="md:col-span-2 flex flex-col gap-6 overflow-y-auto">
                <% user.cart.forEach((item, index)=> { %>
                    <% if (item.product) { %>
                        <div class="rounded-xl shadow-lg bg-white flex overflow-hidden">
                            <div class="w-44 h-44 flex justify-center items-center"
                                style="background-color: <%= item.product.bgcolor %>;">
                                <% if (item.product.image) { %>
                                    <img class="h-32 w-auto object-contain"
                                        src="data:image/jpeg;base64,<%=item.product.image.toString('base64')%>" alt="">
                                    <% } else { %>
                                        <img class="h-32 w-auto object-contain" src="/images/1bag.png"
                                            alt="No image available">
                                        <% } %>
                            </div>
                            <div class="flex flex-col justify-between flex-1 p-6">
                                <div>
                                    <h3 class="text-xl font-bold mb-2" style="color: <%= item.product.textcolor %>;">
                                        <%= item.product.name %>
                                    </h3>
                                </div>
                                <div class="flex items-center gap-4 mt-2">
                                    <form action="/decrement/<%= index %>" method="POST" style="display:inline;">
                                        <button type="submit"
                                            class="w-8 h-8 bg-gray-100 border border-gray-300 rounded-full flex items-center justify-center hover:bg-red-100 text-red-600 text-xl ri-subtract-line transition">
                                            <i class="ri-subtract-line"></i>
                                        </button>
                                    </form>
                                    <div
                                        class="px-4 py-2 rounded-md bg-blue-50 text-blue-700 font-semibold text-base min-w-[2.5rem] text-center">
                                        <%= item.quantity %>
                                    </div>
                                    <form action="/increment/<%= index %>" method="POST" style="display:inline;">
                                        <button type="submit"
                                            class="w-8 h-8 bg-gray-100 border border-gray-300 rounded-full flex items-center justify-center hover:bg-green-100 text-green-700 text-xl ri-add-line transition">
                                            <i class="ri-add-line"></i>
                                        </button>
                                    </form>
                                </div>
                                <div class="flex items-center justify-between mt-4">
                                    <h4 class="font-semibold text-gray-500">Price</h4>
                                    <h2 class="text-lg font-bold text-blue-600">₹ <%= item.product.price %>
                                    </h2>
                                </div>
                            </div>
                        </div>
                        <% } %>
                            <% }) %>
            </div>

            <!-- Price Summary Column -->
            <div class="col-span-1">
                <div class="bg-white rounded-xl shadow-lg p-8 sticky top-28">
                    <h3 class="text-2xl font-bold mb-8 text-gray-800">Price Breakdown</h3>
                    <div class="space-y-4 mb-6">
                        <div class="flex justify-between text-gray-700">
                            <span>Total MRP</span>
                            <span>₹ <%= totalMRP %></span>
                        </div>
                        <div class="flex justify-between text-gray-700">
                            <span>Discount on MRP</span>
                            <span>- ₹ <%= totalDiscount %></span>
                        </div>
                        <div class="flex justify-between text-gray-700">
                            <span>Platform Fee</span>
                            <span>₹ <%= platformFee %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Shipping Fee</span>
                            <span class="font-bold <% if (shippingFee === 0) { %> text-green-600 <% } %>">
                                <%= shippingFee===0 ? 'FREE' : '₹ ' + shippingFee %>
                            </span>
                        </div>
                    </div>
                    <div class="border-t border-gray-300 my-4"></div>
                    <div class="flex justify-between items-center mb-6">
                        <span class="font-bold text-xl">Total Amount</span>
                        <span class="font-bold text-xl text-green-700">₹ <%= totalAmount %></span>
                    </div>
                    <button
                        class="w-full bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-semibold text-lg transition">Checkout</button>
                </div>
            </div>
        </div>
    </div>

    <%- include('./partials/footer') %>